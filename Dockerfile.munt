# 1. Base Setup
# Switched from Ubuntu to Debian Trixie to match LMDE 7 base
FROM debian:trixie AS builder
ENV DEBIAN_FRONTEND=noninteractive

# 2. Install Build Tools & Dependencies
# Included 'ca-certificates' to allow git to verify SSL connections
# NOTE: this must run BEFORE the gcc-16 install (step 2b). It puts trixie's
# binutils 2.44 and the glibc 2.41 dev stack in place, so when gcc-16 is
# installed below, ALL of its non-compiler deps resolve from trixie and
# glibc/binutils are NOT bumped. In a bare container apt instead pulls
# binutils from forky, which then forces glibc 2.43 and would make every
# built binary unrunnable on a stock trixie target.
RUN apt update && apt install -y --no-install-recommends \
    ca-certificates \
    git build-essential pkg-config cmake curl ninja-build meson \
    autoconf autoconf-archive automake bison libtool libgl1-mesa-dev \
    qt6-base-dev libasound2-dev libjack-jackd2-dev libpulse-dev portaudio19-dev \
    file dpkg-dev \
    && rm -rf /var/lib/apt/lists/*

# 2b. GCC 16 / G++ 16 (16.2.0-3) for the build. GCC 16 is the first release
# to enable the full Zen 5 AVX-512 feature set (AVX512_BMM, AVX512_VNNI,
# AVX-VNNI, ...) for -march=znver5 and to use masked AVX-512 vector epilogues
# in auto-vectorization on znver5.
#
# Not in trixie nor trixie-backports — only in forky (testing). Add forky as
# a second suite and install ONLY the pinned compiler family. The
# exact-version deps (cpp-16, libcc1-0, libgcc-16-dev, libstdc++-16-dev, ...)
# come from forky; every other dep is already satisfied by the trixie
# build-essential install above, so trixie's glibc/binutils are NOT bumped.
# Only the GCC-16 runtime support libs (libgcc-s1, libstdc++6, ...) are
# upgraded — builder-only: the final binaries statically link
# libgcc/libstdc++ (LDFLAGS below) and none of that ever lands in the debs.
#
# NOTE: installed by plain name + explicit version pin. apt on trixie
# rejects the `forky/gcc-16` release-qualified syntax ("E: Unable to locate
# package forky") — verified empirically.
RUN printf 'Types: deb\nURIs: http://deb.debian.org/debian\nSuites: forky\nComponents: main\n' \
      > /etc/apt/sources.list.d/forky.sources \
    && apt update \
    && apt install -y --no-install-recommends gcc-16=16.2.0-3 g++-16=16.2.0-3 \
    && rm -rf /var/lib/apt/lists/*

# Make the unversioned compiler names point at GCC 16. On trixie
# /usr/bin/gcc and /usr/bin/g++ are plain symlinks (from the default gcc-14
# toolchain pulled in by build-essential), NOT update-alternatives links —
# so re-point the symlinks. cc/c++ resolve through them.
RUN ln -sf /usr/bin/gcc-16 /usr/bin/gcc \
    && ln -sf /usr/bin/g++-16 /usr/bin/g++ \
    && gcc --version | head -1 \
    && g++ --version | head -1

# 3. Aggressive Optimization Flags for Strix Halo (Zen 5)
ENV CC=/usr/bin/gcc-16
ENV CXX=/usr/bin/g++-16
ENV CFLAGS="-O3 -march=znver5 -mtune=znver5 -mprefer-vector-width=512 -flto=auto -pipe -fPIC -fno-semantic-interposition"
ENV CXXFLAGS="${CFLAGS}"
# -static-libgcc/-static-libstdc++ are REQUIRED with a GCC 16 build: the
# container's libgcc/libstdc++ come from forky's GCC 16 (step 2b) and export
# GLIBCXX up to 3.4.35, while stock trixie's libstdc++6 (14.2.0-19) only
# provides up to 3.4.33. A dynamically linked binary would fail on the
# trixie target with "version GLIBCXX_3.4.34/3.4.35 not found". Static
# linking keeps the debs runnable on plain trixie (glibc + system libs only).
ENV LDFLAGS="-flto=auto -Wl,-O1 -Wl,--as-needed -Wl,-z,now -static-libgcc -static-libstdc++"

# 4. Source Acquisition
RUN git clone https://github.com/munt/munt.git && cd munt && git checkout libmt32emu_2_8_3

# Create the desktop entry inside the Docker image
# FIXED: Path corrected to /munt/mt32emu-qt.desktop to match the copy command below
# (printf '%s\n' with single-quoted args: no backslash-continuation footguns,
# and /bin/sh is dash, whose echo does not interpret escapes anyway)
RUN printf '%s\n' \
    '[Desktop Entry]' \
    'Type=Application' \
    'Name=Munt MT-32 Emulator' \
    'Comment=Roland MT-32, CM-32L and LAPC-I synthesizer emulator' \
    'Exec=mt32emu-qt' \
    'Icon=mt32emu-qt' \
    'Terminal=false' \
    'Categories=AudioVideo;Audio;Synthesizer;Qt;' > /munt/mt32emu-qt.desktop

# 5. Build & Package CORE LIBRARY (libmt32emu)
WORKDIR /munt/mt32emu
RUN cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER=/usr/bin/gcc-16 \
    -DCMAKE_CXX_COMPILER=/usr/bin/g++-16 \
    -DMT32EMU_WITH_QT:BOOL=OFF \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCPACK_GENERATOR="DEB" \
    -DCPACK_PACKAGE_NAME="libmt32emu" \
    -DCPACK_PACKAGE_VERSION="2.8.3" \
    -DCPACK_DEBIAN_PACKAGE_MAINTAINER="Brandon <brandon@framework-desktop>" . && \
    cmake --build build --parallel $(nproc) && \
    cd build && cpack -G DEB && \
    dpkg -i *.deb

# 6. Build & Package GUI (mt32emu-qt)
WORKDIR /munt/mt32emu_qt
RUN cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER=/usr/bin/gcc-16 \
    -DCMAKE_CXX_COMPILER=/usr/bin/g++-16 \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCPACK_GENERATOR="DEB" \
    -DCPACK_PACKAGE_NAME="mt32emu-qt" \
    -DCPACK_PACKAGE_VERSION="2.8.3" \
    -DCPACK_DEBIAN_PACKAGE_MAINTAINER="Brandon <brandon@framework-desktop>" \
    -DCPACK_DEBIAN_PACKAGE_DEPENDS="libmt32emu (>= 2.8.0), qt6-base-dev" . && \
    cmake --build build --parallel $(nproc)

# Manually "install" the desktop file and icon into the build tree for CPack
RUN mkdir -p build/usr/share/applications && \
    cp /munt/mt32emu-qt.desktop build/usr/share/applications/ && \
    mkdir -p build/usr/share/icons/hicolor/scalable/apps && \
    (cp data/mt32emu-qt.svg build/usr/share/icons/hicolor/scalable/apps/ || \
     find /munt -name "mt32emu-qt.svg" -exec cp {} build/usr/share/icons/hicolor/scalable/apps/ \;)

RUN cd build && cpack -G DEB

# 7. Export the .deb
FROM scratch AS export
COPY --from=builder /munt/mt32emu/build/*.deb /
COPY --from=builder /munt/mt32emu_qt/build/*.deb /
